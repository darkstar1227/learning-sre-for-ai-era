# Observability Mode: "langfuse", "collector", or "disabled"
OBSERVABILITY_MODE=disabled

# Langfuse Configuration (if OBSERVABILITY_MODE=langfuse)
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# or for self-hosted:
# LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry Collector (if OBSERVABILITY_MODE=collector)
# OTEL_COLLECTOR_ENDPOINT=http://localhost:4317
OTEL_COLLECTOR_ENDPOINT=http://localhost:4317

# LLM Configuration (for demo/testing)
GEMINI_API_KEY=
MODEL_NAME=gemini-2.0-flash

# LangSmith Configuration (for side-by-side comparison)
# Note: This is optional and for demonstration purposes
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=learning-sre-for-ai-era

# Service Configuration
SERVICE_NAME=answer-api
SERVICE_VERSION=0.1.0
DEBUG=false
